{
  "name": "@scope402/agent",
  "version": "0.1.0",
  "description": "Reference TypeScript client for purchasing and using Scope402 capabilities",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xshobha/scope402.git",
    "directory": "apps/agent"
  },
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "files": [
    "dist/canonical.*",
    "dist/discovery.*",
    "dist/payment-client.*",
    "dist/policy.*",
    "dist/purchase.*",
    "dist/sdk.*",
    "dist/subject.*",
    "dist/tessera-purchase.*",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "demo": "node --env-file-if-exists=.env dist/demo-server.js",
    "dev:demo": "tsx watch --env-file-if-exists=.env src/demo-server.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@x402/core": "2.25.0",
    "@x402/hedera": "2.25.0",
    "canonicalize": "4.0.0",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
