{
  "name": "@scope402/api",
  "private": true,
  "type": "module",
  "scripts": {
    "check:402": "tsx --env-file-if-exists=.env src/check-402.ts",
    "check:blocky": "tsx src/check-blocky.ts",
    "check:github": "tsx --env-file-if-exists=.env src/check-github.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "tsx --test test/blocky.test.ts test/github.test.ts test/health.test.ts test/scans.test.ts test/settlement.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env --test test/*.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@x402/core": "2.25.0",
    "@x402/hedera": "2.25.0",
    "hono": "^4.13.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
