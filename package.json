{
  "name": "scope402",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "check:402": "corepack pnpm --filter @scope402/api check:402",
    "check:blocky": "corepack pnpm --filter @scope402/api check:blocky",
    "dev": "corepack pnpm --filter @scope402/api dev",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm --filter @scope402/api start",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test && corepack pnpm --filter @scope402/api test:integration"
  }
}
